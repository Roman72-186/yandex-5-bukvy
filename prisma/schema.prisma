generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WordDictionary {
  id        Int        @id @default(autoincrement())
  word      String     @unique @db.VarChar(5) // Assuming max 5 characters for a 5-letter word
  dailyWord DailyWord[] // Relation to DailyWord

  @@map("word_dictionary")
}

model DailyWord {
  id        Int            @id @default(autoincrement())
  date      DateTime       @unique @db.Date // Unique date for the daily word
  wordId    Int            @unique
  word      WordDictionary @relation(fields: [wordId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("daily_word")
}
